12. QUERY — TOTAL ALLOCATION FOR PROGRAM IN CYCLE

Always from ledger.

SELECT
program_id,
SUM(amount) AS total_allocated

FROM CLO_HEDGE_ALLOCATIONS

WHERE created_cycle_id = :cycle_id
AND program_id = :program_id

GROUP BY program_id;


---

13. QUERY — TOTAL ALLOCATION PER HEDGE

SELECT
hedge_id,
SUM(amount) allocated

FROM CLO_HEDGE_ALLOCATIONS

WHERE created_cycle_id = :cycle_id

GROUP BY hedge_id;


---

14. QUERY — REMAINING HEDGE IN CYCLE

Remaining capacity per hedge.

SELECT
p.hedge_id,
p.frozen_supply_amt -
COALESCE(SUM(a.amount),0) AS remaining_amt

FROM CLO_CYCLE_HEDGE_POOL p

LEFT JOIN CLO_HEDGE_ALLOCATIONS a
ON p.hedge_id = a.hedge_id
AND a.created_cycle_id = p.cycle_id

WHERE p.cycle_id = :cycle_id

GROUP BY p.hedge_id,p.frozen_supply_amt;


---

15. QUERY — AVAILABLE HEDGES FOR ALLOCATION SCREEN

SELECT
p.hedge_id,
p.frozen_supply_amt -
COALESCE(SUM(a.amount),0) AS remaining_amt

FROM CLO_CYCLE_HEDGE_POOL p

LEFT JOIN CLO_HEDGE_ALLOCATIONS a
ON p.hedge_id = a.hedge_id
AND a.created_cycle_id = p.cycle_id

WHERE p.cycle_id = :cycle_id

GROUP BY p.hedge_id,p.frozen_supply_amt

HAVING p.frozen_supply_amt -
COALESCE(SUM(a.amount),0) > 0;


---

16. QUERY — PROGRAM ALLOCATION REPORT

SELECT
program_id,
SUM(amount) total_allocated

FROM CLO_HEDGE_ALLOCATIONS

WHERE created_cycle_id = :cycle_id

GROUP BY program_id;


---

17. QUERY — LOAN LEVEL HEDGE USAGE

SELECT
h.loan_id,
SUM(a.amount) allocated

FROM CLO_HEDGE_ALLOCATIONS a
JOIN CLO_HEDGE h
ON a.hedge_id = h.hedge_id

WHERE a.created_cycle_id = :cycle_id

GROUP BY h.loan_id;


