16. QUERY — PROGRAM ALLOCATION REPORT

SELECT
program_id,
SUM(amount) total_allocated

FROM CLO_HEDGE_ALLOCATIONS

WHERE created_cycle_id = :cycle_id

GROUP BY program_id;


