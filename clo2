(cycle_id, hedge_id, frozen_supply_amt)

SELECT
:CYCLE_ID,
hedge_id,
reqd_hedge_amt

FROM CLO_HEDGE
WHERE status='OPEN';

After this:

cycle_status = 'FROZEN'

