14. QUERY — REMAINING HEDGE IN CYCLE

Remaining capacity per hedge.

SELECT
p.hedge_id,
p.frozen_supply_amt -
COALESCE(SUM(a.amount),0) AS remaining_amt

FROM CLO_CYCLE_HEDGE_POOL p

LEFT JOIN CLO_HEDGE_ALLOCATIONS a
ON p.hedge_id = a.hedge_id
AND a.created_cycle_id = p.cycle_id

WHERE p.cycle_id = :cycle_id

GROUP BY p.hedge_id,p.frozen_supply_amt;


---

15. QUERY — AVAILABLE HEDGES FOR ALLOCATION SCREEN

SELECT
p.hedge_id,
p.frozen_supply_amt -
COALESCE(SUM(a.amount),0) AS remaining_amt

FROM CLO_CYCLE_HEDGE_POOL p

LEFT JOIN CLO_HEDGE_ALLOCATIONS a
ON p.hedge_id = a.hedge_id
AND a.created_cycle_id = p.cycle_id

WHERE p.cycle_id = :cycle_id

GROUP BY p.hedge_id,p.frozen_supply_amt

HAVING p.frozen_supply_amt -
COALESCE(SUM(a.amount),0) > 0;


