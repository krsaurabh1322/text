9. Query — Remaining Hedge for Next Cycle

When new cycle starts, Camunda calculates rollover.

SELECT
p.hedge_id,
p.cycle_supply_amt
    - COALESCE(SUM(a.amount),0) remaining_amt
FROM LH_CLO_CYCLE_HEDGE_PARTICIPATION p
LEFT JOIN LH_CLO_HEDGE_ALLOCATIONS a
ON p.hedge_id = a.hedge_id
AND a.allocation_cycle_id = p.cycle_id
WHERE p.cycle_id = :prev_cycle
GROUP BY
p.hedge_id,
p.cycle_supply_amt
HAVING
p.cycle_supply_amt - COALESCE(SUM(a.amount),0) > 0;


---

Insert Rollover

INSERT INTO LH_CLO_CYCLE_HEDGE_PARTICIPATION
(
 cycle_id,
 hedge_id,
 cycle_supply_amt,
 created_date
)
SELECT
:next_cycle,
hedge_id,
remaining_amt,
CURRENT_TIMESTAMP
FROM (previous query);


