1. New Table (Participation)

CREATE TABLE LH_CLO_CYCLE_HEDGE_PARTICIPATION (
    cycle_id VARCHAR2(255),
    hedge_id VARCHAR2(255),
    cycle_supply_amt DECIMAL(25,5),
    created_date TIMESTAMP,

    PRIMARY KEY (cycle_id, hedge_id),

    FOREIGN KEY (cycle_id)
        REFERENCES LH_CLO_REPLENISHMENT_CYCLE(cycle_id),

    FOREIGN KEY (hedge_id)
        REFERENCES LH_CLO_HEDGE(hedge_id)
);

Purpose:

tracks hedge supply entering each cycle


